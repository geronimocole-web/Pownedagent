      "path": "/api/scrape",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/scrape",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/scrape",
      "schedule": "0 15 * * *"
    }
  ]
}
