{
  "name": "powned-agent",
  "version": "1.0.0",
  "private": true,
  "description": "PowNed Redactie Agent — AI-gestuurde nieuwsselectie en insteek-generator",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "scrape": "pnpm --filter scraper start",
    "score": "pnpm --filter dna-filter score"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.12"
  }
}
